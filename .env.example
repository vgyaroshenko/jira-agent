JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
# Використовується як fallback для створення бага без --related
# Можна вказати декілька через кому: GN,CCW,DEV
JIRA_PROJECT_KEY=GN,CCW,DEV

# Мова для кожного проекту: UA, RU або EN
# Використовується при генерації тест-кейсів і баг-репортів
# Якщо не вказано — мова визначається за заголовком задачі
PROJECT_LANG_GN=UA
PROJECT_LANG_CCW=EN
PROJECT_LANG_DEV=RU

# Відповідальні за замовчуванням для нових задач/багів (email), опційно.
# Ключ — PROJECT_ASSIGNEE_<FRONT|BACK>_<PROJECT_KEY>, використовується з прапором --area front/back.
# Якщо не вказано — задачу нікому не призначено.
# PROJECT_ASSIGNEE_FRONT_GN=frontend-dev@example.com
# PROJECT_ASSIGNEE_BACK_GN=backend-dev@example.com
